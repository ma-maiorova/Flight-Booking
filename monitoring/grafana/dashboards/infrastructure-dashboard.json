{
  "uid": "flight-booking-infra",
  "title": "Flight Booking — Infrastructure",
  "tags": ["flight-booking", "infrastructure"],
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "PostgreSQL Active Connections",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname=\"flight_db\"}",
          "legendFormat": "flight_db",
          "refId": "A"
        },
        {
          "expr": "pg_stat_activity_count{datname=\"booking_db\"}",
          "legendFormat": "booking_db",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "PostgreSQL Cache Hit Ratio (%)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [
        {
          "expr": "100 * pg_stat_database_blks_hit{datname=\"flight_db\"} / (pg_stat_database_blks_hit{datname=\"flight_db\"} + pg_stat_database_blks_read{datname=\"flight_db\"} + 1)",
          "legendFormat": "flight_db cache hit %",
          "refId": "A"
        },
        {
          "expr": "100 * pg_stat_database_blks_hit{datname=\"booking_db\"} / (pg_stat_database_blks_hit{datname=\"booking_db\"} + pg_stat_database_blks_read{datname=\"booking_db\"} + 1)",
          "legendFormat": "booking_db cache hit %",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Redis Memory Usage",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "Used memory",
          "refId": "A"
        },
        {
          "expr": "redis_memory_max_bytes",
          "legendFormat": "Max memory",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Redis Commands Processed / sec",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [
        {
          "expr": "rate(redis_commands_processed_total[1m])",
          "legendFormat": "ops/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Redis Connected Clients",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [
        {
          "expr": "redis_connected_clients",
          "legendFormat": "clients",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Redis Keyspace Hit Rate (%)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [
        {
          "expr": "100 * redis_keyspace_hits_total / (redis_keyspace_hits_total + redis_keyspace_misses_total + 1)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Redis Uptime (seconds)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [
        {
          "expr": "redis_uptime_in_seconds",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "PostgreSQL Query Rate (commits/sec)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "-- Grafana --" },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=\"flight_db\"}[1m])",
          "legendFormat": "flight_db commits/s",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=\"booking_db\"}[1m])",
          "legendFormat": "booking_db commits/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    }
  ]
}
